{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Co-Agent",
  "version": "0.1.0",
  "identifier": "dev.coagent.council",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Codex-first multi-agent council",
    "longDescription": "A local second screen for inspectable multi-agent deliberation controlled by Codex.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
